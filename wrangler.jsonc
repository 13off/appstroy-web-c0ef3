{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "appstroy-web-c0ef3",
  "main": "worker.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/assets/*"
    ]
  }
}
